# ═══════════════════════════════════════════════════════════════════════
# SmartFin — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=SmartFin Intelligence Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Set to your production domain when deploying (used in email/WhatsApp links)
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────────
POSTGRES_USER=smartfin
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartfin_db

# ── External APIs ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
NEWS_API_KEY=your_news_api_key_here
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ── Scheduler Intervals (minutes) ───────────────────────────────────────
STOCK_FETCH_INTERVAL_MINUTES=5
NEWS_FETCH_INTERVAL_MINUTES=15
FOREX_FETCH_INTERVAL_MINUTES=30

# ── Redis (optional) ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=arthiqaiofficial@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM=arthiqaiofficial@gmail.com
# Note: Use Gmail App Password (not account password).
# Enable 2FA then go to: Google Account → Security → App Passwords

# ── WhatsApp (Twilio Sandbox) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Join Twilio sandbox: text 'join <sandbox-word>' to +1 415 523 8886
# Get creds from: https://console.twilio.com

# ── Notification Scheduler ─────────────────────────────────────────────────────────
RESEARCH_REPORT_INTERVAL_HOURS=6
DAILY_DIGEST_HOUR_IST=8
